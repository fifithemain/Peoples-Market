# Copy to .env.local for local development. Use the Supabase PostgreSQL connection string
# from Project Settings -> Database -> Connection string (URI). Never commit real credentials.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"
ADMIN_ACCESS_KEY="replace-with-a-long-random-secret"
GOOGLE_MAPS_API_KEY="replace-with-a-server-only-key"

# Firebase Web Push (public browser configuration)
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-firebase-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-firebase-web-app-id"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="your-web-push-vapid-public-key"

# Firebase Admin SDK (server-only; never prefix these with NEXT_PUBLIC_)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace-with-service-account-private-key\\n-----END PRIVATE KEY-----\\n"
