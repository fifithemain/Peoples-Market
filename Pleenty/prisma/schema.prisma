datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?   @map("image_url")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  products    Product[]

  @@map("categories")
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  categoryId  String?     @db.Uuid @map("category_id")
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  slug        String      @unique
  description String?
  sku         String?     @unique
  imageUrl    String?     @map("image_url")
  price       Decimal     @db.Decimal(10, 2)
  currency    String      @default("ZAR") @db.Char(3)
  stockQty    Int         @default(0) @map("stock_quantity")
  inStock     Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at")
  orderItems  OrderItem[]

  @@map("products")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String?     @db.Uuid @map("user_id")
  status          String      @default("pending")
  paymentStatus   String      @default("unpaid") @map("payment_status")
  subtotal        Decimal     @db.Decimal(10, 2)
  deliveryFee     Decimal     @default(0) @db.Decimal(10, 2) @map("delivery_fee")
  totalAmount     Decimal     @db.Decimal(10, 2) @map("total")
  currency        String      @default("ZAR") @db.Char(3)
  customerName    String      @map("recipient_name")
  customerPhone   String      @map("phone")
  customerEmail   String?     @map("customer_email")
  yocoCheckoutId  String?     @unique @map("yoco_checkout_id")
  deliveryAddress Json        @map("delivery_address")
  deliveryNotes   String?     @map("notes")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at")
  items              OrderItem[]
  notificationEvents NotificationEvent[]

  @@map("orders")
}

model OrderItem {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @db.Uuid @map("order_id")
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?   @db.Uuid @map("product_id")
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String    @map("product_name")
  price       Decimal   @db.Decimal(10, 2) @map("unit_price")
  quantity    Int
  lineTotal   Decimal   @db.Decimal(10, 2) @map("line_total")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("order_items")
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_settings")
}

model PushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  token      String   @unique
  role       String
  email      String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  @@index([role, email])
  @@map("push_subscriptions")
}

model NotificationEvent {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType String   @map("event_type")
  status    String   @default("pending")
  attempts  Int      @default(0)
  lastError String?  @map("last_error")
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([orderId, eventType])
  @@index([status, updatedAt])
  @@map("notification_events")
}
